load(
    "//bazel:tachyon_cc.bzl",
    "tachyon_cc_binary",
    "tachyon_cc_library",
)

tachyon_cc_library(
    name = "packedposeidon2_config",
    testonly = True,
    srcs = ["packedposeidon2_config.cc"],
    hdrs = ["packedposeidon2_config.h"],
    deps = [
        "//benchmark:config",
        "//benchmark:field_type",
        "//tachyon/base/console",
    ],
)

tachyon_cc_library(
    name = "packedposeidon2_benchmark_runner",
    testonly = True,
    hdrs = ["packedposeidon2_benchmark_runner.h"],
    deps = [
        ":packedposeidon2_config",
        "//benchmark:simple_reporter",
        "//tachyon/base:logging",
        "//tachyon/base:profiler",
        "//tachyon/base/containers:container_util",
        "//tachyon/base/time",
        "//tachyon/c/base:type_traits_forward",
        "//tachyon/crypto/hashes/sponge/poseidon2",
        "//tachyon/crypto/hashes/sponge/poseidon2:poseidon2_plonky3_internal_matrix",
    ],
)

tachyon_cc_binary(
    name = "packedposeidon2_benchmark",
    testonly = True,
    srcs = ["packedposeidon2_benchmark.cc"],
    deps = [
        ":packedposeidon2_benchmark_runner",
        ":packedposeidon2_config",
        "//benchmark:simple_reporter",
        "//benchmark/packedposeidon2/plonky3",
        "//tachyon/base/containers:contains",
        "//tachyon/c/math/finite_fields/baby_bear",
        "//tachyon/crypto/hashes/sponge/poseidon2:poseidon2_external_matrix",
        "//tachyon/crypto/hashes/sponge/poseidon2:poseidon2_external_matrix_traits_forward",
        "//tachyon/crypto/hashes/sponge/poseidon2:poseidon2_horizen_external_matrix",
        "//tachyon/crypto/hashes/sponge/poseidon2:poseidon2_params",
        "//tachyon/math/finite_fields/baby_bear:poseidon2",
    ],
)
